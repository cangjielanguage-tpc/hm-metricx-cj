{
  "apiType": "stageMode",
  "buildOption": {
    "nativeLib": {
      "filter": {
        "excludes": [
          "**/ohos/**libcj_**",
          "**/ohos/**libabilitykit**",
          "**/ohos/**libappkit**",
          "**/ohos/**libcontact**",
          "**/ohos/**libcjLibLoader**",
//          "**/libc++_shared.so"
        ]
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}